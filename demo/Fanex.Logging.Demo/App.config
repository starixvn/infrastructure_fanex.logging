<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging"/>
    </configSections>
    <Fanex.Logging
        filePath="~/Logs"
        defaultCategory="TestingCategory"/>
    <!--<Fanex.Logging
        msmqPath="FormatName:DIRECT=tcp:10.18.200.209\private$\entlib"
        defaultCategory="TestingCategory"/>-->
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
</configuration>