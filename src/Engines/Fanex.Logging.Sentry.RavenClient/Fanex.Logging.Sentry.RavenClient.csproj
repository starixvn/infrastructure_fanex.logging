<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>13.0</LangVersion>
    <Version>2.0.2</Version>
    <AssemblyVersion>2.0.2</AssemblyVersion>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Authors>RnD</Authors>
    <Company>_</Company>
    <Description>- Raven Client Sentry Logging Engine for Fanex.Logging
- https://docs.nexdev.net/docs/fanexlogging/en/latest/</Description>
    <PackageReleaseNotes>- Support .net 4.0
- Support config timeout for writing logs</PackageReleaseNotes>
    <PackageProjectUrl>https://docs.nexdev.net/docs/fanexlogging/en/latest/</PackageProjectUrl>
    <RepositoryUrl>https://gitlab.nexcel.vn/infrastructure/fanex.logging</RepositoryUrl>
    <PackageTags>Fanex.Logging, Logging, Sentry</PackageTags>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="6.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fanex.Logging" Version="2.0.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SharpRaven" Version="2.4.0" />

  </ItemGroup>

</Project>
