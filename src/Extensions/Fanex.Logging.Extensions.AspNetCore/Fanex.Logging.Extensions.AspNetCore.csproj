<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0; net5.0; net7.0</TargetFrameworks>
    <Authors>R&amp;D</Authors>
    <Company>_</Company>
    <Product>_</Product>
    <Version>1.0.1-beta1</Version>
    <PackageReleaseNotes>- Log more information when http context is null</PackageReleaseNotes>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net5.0' Or '$(TargetFramework)' == 'net7.0'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.AspNetCore" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fanex.Logging" Version="2.0.1.1" />
    <PackageReference Include="Fanex.Logging.Extensions" Version="1.0.6.1" />
  </ItemGroup>

</Project>
